# Public values only. The anon key is safe to ship: Row Level Security decides what it can do.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: PersonaAI. Best practice is to leave these unset and deploy the persona-ai
# edge function instead (see docs/AI.md). Only set a key that is restricted to your site.
# EXPO_PUBLIC_GEMINI_API_KEY=your-restricted-key
# EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest
